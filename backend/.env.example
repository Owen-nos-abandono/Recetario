ENVIRONMENT=development

# Base de datos (SQLite por defecto; para Postgres usa algo como:
# postgresql://usuario:password@localhost:5432/recetario)
DATABASE_URL=sqlite:///./recetario.db

# Genera uno seguro con: openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_LARGA

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Dominios permitidos para el frontend (separados por coma)
ALLOWED_ORIGINS=http://localhost:4200
